void mainImage(out vec4 o,in vec2 f)
{vec2 u=f-iResolution.xy*.5;float d=11./255.;int c=0;float S=3.;
for(int i=0;i<7;i++){vec2 p=mod(u+S*.5,S);
c+=int(p.x>=S/3.&&p.x<S*2./3.&&p.y>=S/3.&&p.y<S*2./3.);
S*=3.;};o=vec4(vec3(1.-(float(c&1)*d)),1.);}

