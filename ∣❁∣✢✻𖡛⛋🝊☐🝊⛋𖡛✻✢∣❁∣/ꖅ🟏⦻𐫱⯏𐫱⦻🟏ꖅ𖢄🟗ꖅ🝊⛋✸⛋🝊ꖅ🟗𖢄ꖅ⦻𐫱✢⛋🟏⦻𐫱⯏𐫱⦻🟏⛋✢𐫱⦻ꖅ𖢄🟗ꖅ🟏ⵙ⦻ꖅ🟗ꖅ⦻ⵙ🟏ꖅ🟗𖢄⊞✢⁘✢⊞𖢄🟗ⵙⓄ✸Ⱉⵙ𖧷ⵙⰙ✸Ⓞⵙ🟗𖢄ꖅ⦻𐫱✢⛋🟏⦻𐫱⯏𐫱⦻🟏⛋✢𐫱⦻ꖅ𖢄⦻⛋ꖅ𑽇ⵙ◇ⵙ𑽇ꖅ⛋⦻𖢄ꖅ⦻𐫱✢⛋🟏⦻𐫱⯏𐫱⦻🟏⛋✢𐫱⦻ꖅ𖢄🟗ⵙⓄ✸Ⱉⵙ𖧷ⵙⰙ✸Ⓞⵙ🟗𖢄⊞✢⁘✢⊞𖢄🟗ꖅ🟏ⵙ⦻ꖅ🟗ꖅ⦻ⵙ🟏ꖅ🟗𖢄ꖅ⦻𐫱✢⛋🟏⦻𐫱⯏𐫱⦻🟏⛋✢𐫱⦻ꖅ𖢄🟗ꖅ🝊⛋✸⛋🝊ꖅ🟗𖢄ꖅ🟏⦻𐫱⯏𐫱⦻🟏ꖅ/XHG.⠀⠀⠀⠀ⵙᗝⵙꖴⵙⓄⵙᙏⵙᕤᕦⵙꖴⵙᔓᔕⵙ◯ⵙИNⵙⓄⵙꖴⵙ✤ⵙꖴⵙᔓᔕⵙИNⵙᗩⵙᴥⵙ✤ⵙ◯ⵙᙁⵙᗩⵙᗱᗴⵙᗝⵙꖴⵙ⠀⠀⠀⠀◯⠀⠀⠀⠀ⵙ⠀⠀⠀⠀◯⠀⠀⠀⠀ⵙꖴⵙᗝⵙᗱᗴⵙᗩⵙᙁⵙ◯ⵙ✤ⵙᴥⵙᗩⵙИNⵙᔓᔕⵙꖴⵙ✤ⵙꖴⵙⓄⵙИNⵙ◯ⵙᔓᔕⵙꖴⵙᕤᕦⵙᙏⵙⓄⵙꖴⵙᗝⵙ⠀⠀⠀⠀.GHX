                          <Y>12252</Y>
                          <W>116</W>
                          <H>44</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>28500</X>
                          <Y>12274</Y>
                        </item>
                      </items>
                    </chunk>
