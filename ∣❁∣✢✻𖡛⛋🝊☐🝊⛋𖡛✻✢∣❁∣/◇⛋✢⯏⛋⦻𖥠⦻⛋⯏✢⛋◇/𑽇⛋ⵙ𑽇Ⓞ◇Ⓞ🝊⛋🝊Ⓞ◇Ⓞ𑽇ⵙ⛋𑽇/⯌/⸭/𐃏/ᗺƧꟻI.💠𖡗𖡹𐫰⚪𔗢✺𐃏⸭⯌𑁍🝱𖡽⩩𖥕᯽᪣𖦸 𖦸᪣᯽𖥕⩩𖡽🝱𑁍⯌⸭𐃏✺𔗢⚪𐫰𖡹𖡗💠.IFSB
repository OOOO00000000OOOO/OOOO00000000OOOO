A:=1;V:=(2^-11.5)*atan(2*1/2);X:=0;Y:=0;Z:=1/A/tan(V/2);
camera position (-X,0,-Z) direction(X,0,Z) vertical(0,1,0) fov(V);
#light color (64) position (0,0,-8*sqrt(2)) shadows(0);#
ambient(1);background(1);antialiasing(3);
O:=translate(2-sqrt(2),0,0) scale(sqrt(2)-1) stretch(-1,0,0,sqrt(2)-1);
OO:=scale(3-2*sqrt(2));
set O88O = bound(0,0,0,1) (OO + (id()+rotate(90)+rotate(180)+rotate(270)) O) O88O;
set O00O = bound(0,0,0,1) ((id()+rotate(90)+rotate(180)+rotate(270)) O) O00O;
build (id()+rotate(0,1,0,90)+rotate(0,1,0,180)+rotate(0,1,0,270)+rotate(1,0,0,90)+rotate(1,0,0,270))
bound(0,0,0,1) translate(0,0,sqrt(2)) stretch(0,0,-1,sqrt(2)-1) O00O;color(1);
build (id()+rotate(0,1,0,90)+rotate(0,1,0,180)+rotate(0,1,0,270)+rotate(1,0,0,90)+rotate(1,0,0,270))
bound(0,0,0,1) translate(0,0,sqrt(2)) stretch(0,0,-1,sqrt(2)-1) O88O;color(0,.958,.487);