string types[] = {\"v\", \"f\", \"i\"};

s@internal_name = \"_attrib_\" + s@stroke_attrib + \"_\" + types[i@stroke_attribtype];

s@internal_name_vector = \"_tmp\";
s@internal_name_float = \"_tmp\";
