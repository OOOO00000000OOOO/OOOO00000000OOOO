      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../uv_tx\") }
    }
    channel ty {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../uv_ty\") }
    }
