Content-Disposition: attachment; filename="obj/O____YRTEMOEG____O____GEOMETRY____O/O_NOITCEJORP_CINOMONG_O_GNOMONIC_PROJECTION_O2/attribvop1/snippet1.parm"
Content-Type: text/plain

{
version 0.8
code	[ 0	locks=0 ]	(	[ code	"@O_EULAV_O_VALUE_O=ch(\"O_EULAV_O_VALUE_O\");
@O_EULAV_O_VALUE_O=1;
vector pt;
    pt.x = 2*@P.x / (@O_EULAV_O_VALUE_O + pow(@P.x,2) + pow(@P.y,2));
    pt.y = 2*@P.y / (@O_EULAV_O_VALUE_O + pow(@P.x,2) + pow(@P.y,2));
    pt.z = -(-@O_EULAV_O_VALUE_O/2 + pow(@P.x,2) +pow(@P.y,2)) / (@O_EULAV_O_VALUE_O + pow(@P.x,2) + pow(@P.y,2));
    //pt.z +=1;
    //pt*=.5;


@P = pt;
" ] 	)
includes	[ 0	locks=0 ]	(	""	)
outercode	[ 0	locks=0 ]	(	""	)
expandcode	[ 0	locks=0 ]	(	"on"	)
strict	[ 0	locks=0 ]	(	[ strict	0 ] 	)
namenum	[ 0	locks=0 ]	(	0	)
exportlist	[ 0	locks=0 ]	(	[ exportlist	* ] 	)
forcecodegeneration	[ 0	locks=0 ]	(	"on"	)
strictvariables	[ 0	locks=0 ]	(	"on"	)
}

