@O_TNEIDARG_YTISNED_RAENIL_ECILS_EMULOV_O_VOLUME_SLICE_LINEAR_DENSITY_GRADIENT_O=(@density);
// Ⓞ TИEIDAЯG Ⓞ YTISИED Ⓞ ЯAEИIL Ⓞ ECILS Ⓞ EMULOV Ⓞ   Ⓞ VOLUME Ⓞ SLICE Ⓞ LINEAR Ⓞ DENSITY Ⓞ GRADIENT Ⓞ \\
//
//
//
