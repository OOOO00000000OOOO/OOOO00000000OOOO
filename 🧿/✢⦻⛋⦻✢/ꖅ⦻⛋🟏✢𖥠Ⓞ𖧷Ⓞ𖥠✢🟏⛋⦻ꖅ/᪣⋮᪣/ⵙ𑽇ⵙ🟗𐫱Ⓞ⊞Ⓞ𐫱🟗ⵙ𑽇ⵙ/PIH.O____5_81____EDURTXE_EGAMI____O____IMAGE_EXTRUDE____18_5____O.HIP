    }
    channel sy {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = if(ch(\"../uv_invertv\"),-1*ch(\"../uv_scale\"),ch(\"../uv_scale\")) }
    }
    channel rz {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../uv_rz\") }
    }
  }

