            "green"     "Green"
            "blue"      "Blue"
            "alpha"     "Alpha"
            "greyscale" "Greyscale"
        }
        range   { 0 4 }
        parmtag { "parmvop" "1" }
        parmtag { "shaderparmcontexts" "cvex" }
    }
    parm {
        name    "export_attribute"
