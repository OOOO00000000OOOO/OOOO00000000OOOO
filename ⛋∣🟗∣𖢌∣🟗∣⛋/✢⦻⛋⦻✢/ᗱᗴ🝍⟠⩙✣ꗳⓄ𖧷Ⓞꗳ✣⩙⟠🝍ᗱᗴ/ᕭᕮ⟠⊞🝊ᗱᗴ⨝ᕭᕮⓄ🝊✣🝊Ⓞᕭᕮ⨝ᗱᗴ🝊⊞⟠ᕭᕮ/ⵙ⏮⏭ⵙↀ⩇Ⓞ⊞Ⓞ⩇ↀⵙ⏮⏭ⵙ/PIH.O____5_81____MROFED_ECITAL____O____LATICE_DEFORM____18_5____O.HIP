      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = lock(1) }
    }
    channel sz {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = lock(1) }
    }
    channel scale {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = lock(1) }
    }
    channel resy {
      lefttype = extend
      righttype = extend
      default = 720
      flags = 0
      segment { length = 0 value = 720 720 expr = ch(\"resx\") }
    }
  }

