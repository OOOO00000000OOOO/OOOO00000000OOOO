                type    string
                default { "diffuse reflect coat refract volume" }
                range   { 0 1 }
                parmtag { "spare_category" "Extra Image Planes" }
            }
            parm {
                name    "vm_quickplane_P"
                label   "Shading Position (P)"
                type    toggle
                default { "0" }
                range   { 0 1 }
                parmtag { "spare_category" "Extra Image Planes" }
