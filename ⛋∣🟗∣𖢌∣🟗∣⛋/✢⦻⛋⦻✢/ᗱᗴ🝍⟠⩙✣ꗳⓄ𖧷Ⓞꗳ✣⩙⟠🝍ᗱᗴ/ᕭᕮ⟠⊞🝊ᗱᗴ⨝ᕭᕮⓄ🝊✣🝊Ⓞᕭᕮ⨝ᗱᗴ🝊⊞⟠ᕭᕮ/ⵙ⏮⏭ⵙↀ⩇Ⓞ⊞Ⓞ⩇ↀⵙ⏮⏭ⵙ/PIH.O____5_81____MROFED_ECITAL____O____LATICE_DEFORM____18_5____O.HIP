            multiparm {
                name    "vm_numaux"
                label    "Extra Image Planes"
                parmtag { "spare_category" "Extra Image Planes" }

                parm {
                    name    "vm_disable_plane#"
                    label   "Disable Plane #"
                    type    toggle
                    joinnext
                    default { "0" }
                    range   { 0 1 }
