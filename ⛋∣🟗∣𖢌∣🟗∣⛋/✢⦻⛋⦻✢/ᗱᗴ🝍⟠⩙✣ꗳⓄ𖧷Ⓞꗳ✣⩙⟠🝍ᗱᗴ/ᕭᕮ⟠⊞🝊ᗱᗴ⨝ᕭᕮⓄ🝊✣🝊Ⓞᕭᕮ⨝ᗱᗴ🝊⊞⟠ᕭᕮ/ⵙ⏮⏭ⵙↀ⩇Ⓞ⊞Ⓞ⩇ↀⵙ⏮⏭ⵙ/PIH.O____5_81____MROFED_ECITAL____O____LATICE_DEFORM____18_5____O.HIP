{
    channel outtype1 {
      lefttype = extend
      righttype = extend
      defaultString = chs(\"../signature\")
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = "\"vector\" if ch(\"../signature\") == \"default\" else \"vector4\"" language = python }
    }
