--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="shop/vopmaterial1/texture1/inline1.parm"
Content-Type: text/plain

{
version 0.8
code	[ 0	locks=0 ]	(	"if ($_map != \"\") {
#if defined(VOP_SHADING)
    int fptex = $isconnected__ptexface ? $_ptexface : getptextureid();
#else
    int fptex = $_ptexface;
#endif
    string wrapmode = $_wrap;
    if ($_orient & 0x02) { $_uv.y = 1 - $_uv.y; }
    if ($_orient & 0x04) { float x = $_uv.x; $_uv.x = $_uv.y; $_uv.y = x; }
    string _map_udim = $_map;
    string ocio = ocio_parsecolorspace($_map);
    if ($_udim && has_udim($_map))
        _map_udim = expand_udim($_uv.x, $_uv.y, $_map);
    if (_map_udim == '') { $clr = set($_defclr); }
    else {
        if (_map_udim != $_map) {
            $_uv.x %= 1.0; $_uv.y %= 1.0;
            wrapmode = 'streak';
        }
        if ($_orient & 0x01) { $_uv.x = 1 - $_uv.x; }
        if ($isconnected__duv != 0) {
            vector $tduv = 0.5 * $_duv;
            if ($_orient & 0x04) { float x = $tduv.x; $tduv.x = $tduv.y; $tduv.y = x; }
            $clr = texture(_map_udim,
                     $_uv.x - $tduv.x, $_uv.y - $tduv.y,
                     $_uv.x + $tduv.x, $_uv.y - $tduv.y,
                     $_uv.x + $tduv.x, $_uv.y + $tduv.y,
                     $_uv.x - $tduv.x, $_uv.y + $tduv.y,
                    \"wrap\", wrapmode, \"filter\", $_filter,
                    \"width\", $_width, \"border\", $_border,
                    \"extrapolate\", $_extrapol, \"lerp\", $_interp,
                    \"channel\", $_channel, \"face\", fptex,
                    \"blur\", $_blur, \"pixelblur\", $_pixelblur,
                    \"srccolorspace\", ocio == '' ? $_srccolorspace : 'linear');
        } else {
            $clr = texture(_map_udim, $_uv.x, $_uv.y, \"wrap\", wrapmode,
                    \"filter\", $_filter, \"width\", $_width,
                    \"border\", $_border, \"extrapolate\", $_extrapol,
                    \"channel\", $_channel, \"face\", fptex,
                    \"lerp\", $_interp,
                    \"blur\", $_blur, \"pixelblur\", $_pixelblur,
                    \"srccolorspace\", ocio == '' ? $_srccolorspace : 'linear');
        }
        if (ocio != '')
            $clr = ocio_transform(ocio, \"scene_linear\", $clr);
    }
} else {
   $clr = set($_defclr);
}
"	)
includes	[ 0	locks=0 ]	(	"voptype.h voplib.h"	)
outercode	[ 0	locks=0 ]	(	""	)
expandcode	[ 0	locks=0 ]	(	"off"	)
