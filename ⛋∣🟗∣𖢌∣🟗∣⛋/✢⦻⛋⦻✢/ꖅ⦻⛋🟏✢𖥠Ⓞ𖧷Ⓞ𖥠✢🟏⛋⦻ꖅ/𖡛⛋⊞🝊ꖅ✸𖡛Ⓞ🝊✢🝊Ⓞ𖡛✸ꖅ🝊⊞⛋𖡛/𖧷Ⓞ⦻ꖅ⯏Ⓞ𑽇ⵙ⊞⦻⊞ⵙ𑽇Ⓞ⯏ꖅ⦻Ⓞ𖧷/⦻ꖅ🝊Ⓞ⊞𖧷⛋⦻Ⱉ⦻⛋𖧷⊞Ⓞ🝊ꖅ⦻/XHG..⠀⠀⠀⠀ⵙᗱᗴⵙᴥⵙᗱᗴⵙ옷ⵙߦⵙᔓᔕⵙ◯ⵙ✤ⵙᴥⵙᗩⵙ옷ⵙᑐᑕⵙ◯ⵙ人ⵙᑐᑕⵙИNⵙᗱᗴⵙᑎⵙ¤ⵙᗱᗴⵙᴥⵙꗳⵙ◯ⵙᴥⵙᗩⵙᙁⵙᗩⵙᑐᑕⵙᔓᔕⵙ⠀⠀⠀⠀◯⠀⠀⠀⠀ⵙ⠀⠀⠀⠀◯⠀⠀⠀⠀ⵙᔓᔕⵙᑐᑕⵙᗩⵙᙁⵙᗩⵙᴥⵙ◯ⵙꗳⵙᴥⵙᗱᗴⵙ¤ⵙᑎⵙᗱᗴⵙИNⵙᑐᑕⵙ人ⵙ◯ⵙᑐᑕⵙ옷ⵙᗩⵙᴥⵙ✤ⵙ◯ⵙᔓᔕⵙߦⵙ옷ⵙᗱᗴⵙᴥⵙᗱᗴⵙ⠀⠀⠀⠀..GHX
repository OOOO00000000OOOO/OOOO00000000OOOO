                    <item name="ScriptSource" type_name="gh_string" type_code="10">    int pointsPerTurn = 12;

    if (railCurve == null) return;
    A = NurbsCurve.CreateSpiral(
      railCurve,
      t0,
      t1,
      radiusPoint,
      pitch,
      turnCount,
      radius0,
      radius1,
      pointsPerTurn);
    </item>
