              <chunks count="1">
                <chunk name="Container">
                  <items count="5">
                    <item name="Description" type_name="gh_string" type_code="10">Recursively transform geometry to get a self-referential step sequence of transformed geometry.</item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">f22e9917-a2d4-463f-bae1-fbca0626ce27</item>
