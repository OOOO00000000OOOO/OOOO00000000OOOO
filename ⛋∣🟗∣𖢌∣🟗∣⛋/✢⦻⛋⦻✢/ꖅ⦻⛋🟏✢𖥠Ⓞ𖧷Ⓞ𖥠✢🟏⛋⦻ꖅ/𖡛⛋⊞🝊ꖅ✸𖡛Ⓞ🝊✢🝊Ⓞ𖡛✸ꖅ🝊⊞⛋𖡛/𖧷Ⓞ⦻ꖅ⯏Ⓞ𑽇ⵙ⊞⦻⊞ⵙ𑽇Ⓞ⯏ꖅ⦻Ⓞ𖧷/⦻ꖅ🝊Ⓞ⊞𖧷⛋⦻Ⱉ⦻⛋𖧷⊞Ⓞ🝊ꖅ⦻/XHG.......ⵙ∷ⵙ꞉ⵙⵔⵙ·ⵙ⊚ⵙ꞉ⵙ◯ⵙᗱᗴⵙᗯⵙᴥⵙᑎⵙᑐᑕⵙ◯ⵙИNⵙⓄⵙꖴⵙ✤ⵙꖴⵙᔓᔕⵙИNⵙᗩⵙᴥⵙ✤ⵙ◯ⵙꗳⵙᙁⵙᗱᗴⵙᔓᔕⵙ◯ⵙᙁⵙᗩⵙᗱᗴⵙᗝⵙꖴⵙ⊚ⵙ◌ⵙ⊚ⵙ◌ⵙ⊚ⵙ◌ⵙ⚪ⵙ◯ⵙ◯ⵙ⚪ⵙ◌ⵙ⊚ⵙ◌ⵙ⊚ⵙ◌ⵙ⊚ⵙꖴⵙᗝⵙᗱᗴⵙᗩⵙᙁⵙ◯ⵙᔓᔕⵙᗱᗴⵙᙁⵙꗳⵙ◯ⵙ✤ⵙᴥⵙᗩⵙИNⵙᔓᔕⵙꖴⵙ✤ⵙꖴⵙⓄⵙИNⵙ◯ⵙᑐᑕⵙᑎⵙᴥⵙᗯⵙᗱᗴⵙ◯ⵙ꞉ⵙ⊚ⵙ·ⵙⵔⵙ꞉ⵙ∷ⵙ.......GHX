                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import rhinoscriptsyntax as rs
import scriptcontext as sc
import ghpythonremote
from ghpythonlib.treehelpers import list_to_tree # Rhino 6 only!
np = sc.sticky['numpy'];
sp = sc.sticky['scipy'];
a = np.diff(x);
a = ghpythonremote.obtain(a.tolist());
a = list_to_tree(a, source=[0,0]);</item>
