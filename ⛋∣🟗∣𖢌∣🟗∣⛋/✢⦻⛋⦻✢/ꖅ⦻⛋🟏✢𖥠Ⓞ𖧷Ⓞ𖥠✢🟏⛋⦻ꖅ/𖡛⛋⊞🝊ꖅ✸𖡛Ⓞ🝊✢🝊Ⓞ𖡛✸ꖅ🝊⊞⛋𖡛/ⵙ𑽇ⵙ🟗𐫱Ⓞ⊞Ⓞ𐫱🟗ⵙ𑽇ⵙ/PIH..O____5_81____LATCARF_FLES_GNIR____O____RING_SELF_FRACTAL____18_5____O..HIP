@O_TNEIDARG_YTISNED_GNIR_EGDE_CRA_ECILS_EMULOV_O_VOLUME_SLICE_ARC_EDGE_RING_DENSITY_GRADIENT_O=((    (-sqrt(((-cos(3.*(@density)))))/1)    +    ((-sqrt(((cos(3.*(@density)))))+1)/1)    )*1.0625);
