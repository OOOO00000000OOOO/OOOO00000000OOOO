@O_TNEIDARG_YTISNED_EGDE_CRA_ECILS_EMULOV_O_VOLUME_SLICE_ARC_EDGE_DENSITY_GRADIENT_O=((-sqrt(((cos(.5*3.*(@density)))))+1)*1.0625);
