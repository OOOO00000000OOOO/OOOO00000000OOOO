@O_TNEIDARG_YTISNED_LADIOSUNISOC_ECILS_EMULOV_O_VOLUME_SLICE_COSINUSOIDAL_DENSITY_GRADIENT_O=((1-cos(1*3.*(@density)))/2);
// Ⓞ TИEIDAЯG Ⓞ YTISИED Ⓞ LADIOSUИISOC Ⓞ ECILS Ⓞ EMULOV Ⓞ   Ⓞ VOLUME Ⓞ SLICE Ⓞ COSINUSOIDAL Ⓞ DENSITY Ⓞ GRADIENT Ⓞ \\
