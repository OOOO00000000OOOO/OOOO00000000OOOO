@O_TNEIDARG_YTISNED_CRA_ECILS_EMULOV_O_VOLUME_SLICE_ARC_DENSITY_GRADIENT_O=(    (sqrt(((-cos(3.*(@density)))))/2)    +    ((-sqrt(((cos(3.*(@density)))))+1)/2)    );
// Ⓞ TИEIDAЯG Ⓞ YTISИED Ⓞ CRA Ⓞ ECILS Ⓞ EMULOV Ⓞ   Ⓞ VOLUME Ⓞ SLICE Ⓞ ARC Ⓞ DENSITY Ⓞ GRADIENT Ⓞ \\
