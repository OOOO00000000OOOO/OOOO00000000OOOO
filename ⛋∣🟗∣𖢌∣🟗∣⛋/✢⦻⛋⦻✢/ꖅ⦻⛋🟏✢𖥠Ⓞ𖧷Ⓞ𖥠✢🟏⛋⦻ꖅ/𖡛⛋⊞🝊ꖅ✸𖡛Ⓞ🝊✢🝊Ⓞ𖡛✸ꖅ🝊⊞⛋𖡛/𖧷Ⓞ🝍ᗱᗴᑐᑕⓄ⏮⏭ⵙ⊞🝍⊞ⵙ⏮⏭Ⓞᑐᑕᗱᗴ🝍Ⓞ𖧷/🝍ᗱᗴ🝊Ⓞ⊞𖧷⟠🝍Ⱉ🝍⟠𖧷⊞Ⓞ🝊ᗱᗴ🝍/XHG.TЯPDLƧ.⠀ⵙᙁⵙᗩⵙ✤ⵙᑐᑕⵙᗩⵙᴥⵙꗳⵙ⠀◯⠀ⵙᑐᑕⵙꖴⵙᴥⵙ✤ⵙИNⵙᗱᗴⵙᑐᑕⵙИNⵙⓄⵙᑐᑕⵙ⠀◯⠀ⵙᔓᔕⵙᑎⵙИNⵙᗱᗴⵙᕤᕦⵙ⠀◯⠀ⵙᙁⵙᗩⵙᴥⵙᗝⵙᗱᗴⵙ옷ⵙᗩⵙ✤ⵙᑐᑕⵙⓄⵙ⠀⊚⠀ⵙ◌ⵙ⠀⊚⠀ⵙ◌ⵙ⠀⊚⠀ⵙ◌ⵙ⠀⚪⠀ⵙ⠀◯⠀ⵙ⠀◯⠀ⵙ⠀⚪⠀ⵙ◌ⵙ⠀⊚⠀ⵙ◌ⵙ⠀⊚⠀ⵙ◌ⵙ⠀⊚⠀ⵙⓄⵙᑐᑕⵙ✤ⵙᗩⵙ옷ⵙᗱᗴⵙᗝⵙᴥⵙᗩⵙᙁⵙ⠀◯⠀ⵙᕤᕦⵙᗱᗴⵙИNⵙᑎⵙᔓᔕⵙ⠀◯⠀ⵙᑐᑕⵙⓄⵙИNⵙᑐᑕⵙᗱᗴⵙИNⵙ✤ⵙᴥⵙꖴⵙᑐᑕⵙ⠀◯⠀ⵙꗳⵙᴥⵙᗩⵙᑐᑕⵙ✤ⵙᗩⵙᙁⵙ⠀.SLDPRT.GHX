                <item name="Name" type_name="gh_string" type_code="10">P</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="AdditionalSource" type_name="gh_string" type_code="10">  Private Function appendprepend(ByVal i As Integer)
    Dim srsEnum As IEnumerable(Of Integer) = Enumerable.Range(0, i + 1)
    Dim arrVal As New list(Of Integer)
    arrVal = srsEnum.tolist()
    arrVal.add(0)
    arrVal.insert(0, i)
    Return arrVal.toarray()
  End Function


  Private Function colorCap(ByVal c As list(Of color))
    Dim i,k As Integer
    k = c.count() / 2
    Dim r(2),g(2),b(2) As Integer
    For i = 0 To k - 1 Step 1
      r(0) += c.item(i).R
      r(1) += c.item(i + k).R
      g(0) += c.item(i).g
      g(1) += c.item(i + k).g
      b(0) += c.item(i).b
      b(1) += c.item(i + k).b
    Next

    r(0) = CInt(r(0) / k)
    r(1) = CInt(r(1) / k)
    g(0) = CInt(g(0) / k)
    g(1) = CInt(g(1) / k)
    b(0) = CInt(b(0) / k)
    b(1) = CInt(b(1) / k)

    r(2) = CInt((r(0) + r(1)) / 2)
    g(2) = CInt((g(0) + g(1)) / 2)
    b(2) = CInt((b(0) + b(1)) / 2)

    If r(0) &gt; 255 Then r(0) = 255 Else If r(0) &lt; 0 Then r(0) = 0
    If r(1) &gt; 255 Then r(1) = 255 Else If r(1) &lt; 0 Then r(1) = 0
    If g(0) &gt; 255 Then g(0) = 255 Else If g(0) &lt; 0 Then g(0) = 0
    If g(1) &gt; 255 Then g(1) = 255 Else If g(1) &lt; 0 Then g(1) = 0
    If b(0) &gt; 255 Then b(0) = 255 Else If b(0) &lt; 0 Then b(0) = 0
    If b(1) &gt; 255 Then b(1) = 255 Else If b(1) &lt; 0 Then b(1) = 0

    If r(2) &gt; 255 Then r(2) = 255 Else If r(2) &lt; 0 Then r(2) = 0
    If g(2) &gt; 255 Then g(2) = 255 Else If g(2) &lt; 0 Then g(2) = 0
    If b(2) &gt; 255 Then b(2) = 255 Else If b(2) &lt; 0 Then b(2) = 0

    Return {color.FromArgb(r(0), G(0), b(0)),color.FromArgb(r(1), G(1), b(1)),color.FromArgb(r(2), G(2), b(2))}
  End Function

  Private Function dblCList(ByVal a As list(Of color))
    a.addrange(a)
    Return a
  End Function

  Private Function dblDList(ByVal a As list(Of Double))
    a.addrange(a)
    Return a
  End Function

  Private Function matchDbl(ByVal a As list(Of Double), ByVal t As Integer)
    Dim i,k As Integer
    k = a.count()
    For i = 0 To ((t + 1) - k) - 1 Step 1
      a.add(a.item(k - 1))
    Next
    Return a
  End Function

  Private Function matchClr(ByVal a As list(Of Color), ByVal t As Integer)
    Dim i,k As Integer
    k = a.count()
    For i = 0 To ((t + 1) - k) - 1 Step 1
      a.add(a.item(k - 1))
    Next
    Return a
  End Function

  Private Function sumC(ByVal ca As Color, ByVal cb As Color)
    Dim r,g,b As Integer

    r = CInt((CInt(ca.R) + CInt(cb.R)) / 2)
    g = CInt((CInt(ca.g) + CInt(cb.g)) / 2)
    b = CInt((CInt(ca.b) + CInt(cb.b)) / 2)

    If r &gt; 255 Then r = 255 Else If r &lt; 0 Then r = 0
    If G &gt; 255 Then G = 255 Else If G &lt; 0 Then G = 0
    If b &gt; 255 Then b = 255 Else If b &lt; 0 Then b = 0

    Return color.FromArgb(r, G, b)
  End Function

  Private Function avg4Clr(ByVal ca As Color, ByVal cb As Color, ByVal cc As Color, ByVal cd As Color)
    Dim r,g,b As Integer

    r = CInt((CInt(ca.R) + CInt(cb.R) + CInt(cc.R) + CInt(cd.R)) / 4)
    g = CInt((CInt(ca.g) + CInt(cb.g) + CInt(cc.g) + CInt(cd.g)) / 4)
    b = CInt((CInt(ca.b) + CInt(cb.b) + CInt(cc.b) + CInt(cd.b)) / 4)

    If r &gt; 255 Then r = 255 Else If r &lt; 0 Then r = 0
    If G &gt; 255 Then G = 255 Else If G &lt; 0 Then G = 0
    If b &gt; 255 Then b = 255 Else If b &lt; 0 Then b = 0

    Return color.FromArgb(r, G, b)
  End Function

  Private Function evalP(ByVal op As point3d, ByVal tp As Point3d, ByVal t As Double)
    Return New point3d(op + (tp - op) * t)
  End Function

  Private Function evalV(ByVal ov As vector3d, ByVal tv As vector3d, ByVal t As Double)
    Return New vector3d(ov + (tv - ov) * t)
  End Function

  Private Function evalN(ByVal u As Double, ByVal v As Double, ByVal t As Double)
    Return u + (v - u) * t
  End Function

  Private Function avgVec(ByVal v() As vector3f)
    Dim i As Integer
    Dim tv As Vector3d

    For i = 0 To ubound(v) Step 1
      tv += v(i)
    Next
    tv /= (ubound(v) + 1)
    tv.Unitize()
    Return New vector3f(tv.X, tv.Y, tv.Z)
  End Function

  Private Function roundClr(ByVal r As Integer, ByVal G As Integer, ByVal b As Integer, ByVal i As Integer)
    r = CInt(r / i)
    G = CInt(G / i)
    b = CInt(b / i)

    If r &gt; 255 Then r = 255 Else If r &lt; 0 Then r = 0
    If G &gt; 255 Then G = 255 Else If G &lt; 0 Then G = 0
    If b &gt; 255 Then b = 255 Else If b &lt; 0 Then b = 0

    Return color.FromArgb(r, G, b)
  End Function

  Private Function avgClr(ByVal c() As color)
    Dim r,G,b As Integer
    Dim i,k As Integer

    k = ubound(c) + 1

    For i = 0 To k - 1 Step 1
      r += CInt(c(i).R)
      G += CInt(c(i).G)
      b += CInt(c(i).B)
    Next

    r = CInt(r / k)
    G = CInt(G / k)
    b = CInt(b / k)

    If r &gt; 255 Then r = 255 Else If r &lt; 0 Then r = 0
    If G &gt; 255 Then G = 255 Else If G &lt; 0 Then G = 0
    If b &gt; 255 Then b = 255 Else If b &lt; 0 Then b = 0

    Return color.FromArgb(r, G, b)
  End Function

  Private Function evalC(ByVal oc As color, ByVal tc As color, ByVal t As Double)
    Dim r,G,b As Integer
    r = CInt(CInt(oc.R) + (CInt(tc.R) - CInt(oc.R)) * t)
    G = CInt(CInt(oc.G) + (CInt(tc.G) - CInt(oc.G)) * t)
    b = CInt(CInt(oc.B) + (CInt(tc.B) - CInt(oc.B)) * t)

    If r &gt; 255 Then r = 255 Else If r &lt; 0 Then r = 0
    If G &gt; 255 Then G = 255 Else If G &lt; 0 Then G = 0
    If b &gt; 255 Then b = 255 Else If b &lt; 0 Then b = 0

    Return color.FromArgb(r, G, b)
  End Function

  ''' &lt;summary&gt;
  ''' This method will be called once every solution, before any calls to RunScript.
  ''' &lt;/summary&gt;
  Public Overrides Sub BeforeRunScript()
  End Sub
  ''' &lt;summary&gt;
  ''' This method will be called once every solution, after any calls to RunScript.
  ''' &lt;/summary&gt;
  Public Overrides Sub AfterRunScript()
  End Sub
</item>
                    <item name="Description" type_name="gh_string" type_code="10">Creates a volumetric mesh from either a single mesh face and depth or between two parallel meshes of idential construction based on the topology of the Schwarz P adapted with parametric inputs to the geometric proportions within the bounds of each offset pair of mesh faces.</item>
                    <item name="EditorPosition" type_name="gh_drawing_point" type_code="30">
                      <X>18</X>
                      <Y>229</Y>
                    </item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
                    <item name="IconOverride" type_name="gh_drawing_bitmap" type_code="37">
                      <bitmap length="1246"></bitmap>
                    </item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">3c42fab0-b96e-4784-b75a-45e5ad4cfd16</item>
                    <item name="Locked" type_name="gh_bool" type_code="1">true</item>
                    <item name="Name" type_name="gh_string" type_code="10">P</item>
                    <item name="NickName" type_name="gh_string" type_code="10">P</item>
                    <item name="OutParameter" type_name="gh_bool" type_code="1">true</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    Component.Params.Input(0).Name = "Mesh or Curve"
    Component.Params.Input(0).Description = "Open or closed mesh or curve"
    Component.Params.Input(1).Name = "Mesh or Curve"
    Component.Params.Input(1).Description = "Optional open or closed mesh or curve whose type should correspond to G0."
    Component.Params.Input(2).Name = "Index [Face]"
    Component.Params.Input(2).Description = "An optional integer or list of integers which specify the faces to be modified if the input is a mesh. If no value is supplied then all faces will be modified"
    Component.Params.Input(3).Name = "Vert to Face [Vertex]"
    Component.Params.Input(3).Description = "Evaluates a new vertex between the input geometry's vertex to the face center"
    Component.Params.Input(4).Name = "Edge to Face [Vertex]"
    Component.Params.Input(4).Description = "Evaluates a new vertex between the input geometry's edge midpoint to the face center"
    Component.Params.Input(5).Name = "Vert to Vol [Vertex]"
    Component.Params.Input(5).Description = "Evaluates a new vertex between the input geometry's vertex to the volumetric center"
    Component.Params.Input(6).Name = "Edge to Vol [Vertex]"
    Component.Params.Input(6).Description = "Evaluates a new vertex between the input geometry's edge midpoint to the face center"
    Component.Params.Input(7).Name = "Distance"
    Component.Params.Input(7).Description = "An optional number to add depth if no input is provided for G1"
    Component.Params.Input(8).Name = "Close"
    Component.Params.Input(8).Description = "If true then additional faces and if needed vertices will be added to the mesh, closing the solid"
    Component.Params.Input(9).Name = "Invert"
    Component.Params.Input(9).Description = "If true the faces the close the mesh are reversed, flipping the solid/ void relationship"
    Component.Params.Input(10).Name = "Color [Vertex]"
    Component.Params.Input(10).Description = "(If applied to a mesh a list of colors corresponding to each mesh face, if applied to a curve, a list of colors corresponding to each control point plus an additonal color value for the new averaged center"

    Component.Params.Output(1).Name = "Mesh"
    Component.Params.Output(1).Description = "If successful, a valid mesh"

    If G0 IsNot Nothing Then

      Dim bG,bM, bP,bmC,biC As Boolean

      bM = G0.ObjectType = ObjectType.Mesh
      bP = G0.ObjectType = ObjectType.Curve

      bG = (bM Or bP)
      If G1 IsNot Nothing Then
        If bM And G1.ObjectType &lt;&gt; ObjectType.Mesh Then bG = False
        If bP And G1.ObjectType &lt;&gt; ObjectType.Curve Then bG = False
      End If

      If bG Then
        Dim msh,msha,mshe As New mesh
        Dim crv,crva As curve
        Dim av(2) As point3d
        Dim ac(2),ax(1) As color
        Dim h,j,jj,k,u,v,ua,ub,va,vb,w As Integer
        Dim cv,cf,ce,dcv As Integer
        Dim x(),y() As Integer
        Dim bnk() As Boolean = Nothing

        Dim mv,fv,ep,tv,ecv,np As New list(Of Point3d)
        Dim mev,mvv As New dictionary(Of String, Integer)
        Dim mf As Rhino.Geometry.Collections.MeshFaceList = Nothing
        Dim mtv As Rhino.Geometry.Collections.MeshTopologyVertexList = Nothing
        Dim mte As Rhino.Geometry.Collections.MeshTopologyEdgeList = Nothing
        Dim ev As New list(Of vector3d)
        Dim ed As New list(Of Double)
        Dim en As New list(Of Boolean)
        Dim mc,ec,tc,cc,fc,ecc,nc As New list(Of color)
        Dim xf As New list(Of meshface)

        If clr.count() = 0 Then clr.add(color.LightGray) Else biC = True

        If bm Then
          'Start Deconstruct if Mesh
          msh = G0

          mshe = msh.Duplicate()
          mte = mshe.TopologyEdges()
          mtv = mshe.TopologyVertices()
          mf = mshe.Faces()

          bnk = mshe.GetNakedEdgePointStatus()

          If G1 IsNot Nothing Then
            msha = G1

            If msh.Vertices.Count() &lt;&gt; msha.vertices.count() Then Exit Sub
          Else
            msha = msh.Offset(-d)
          End If

          msh.Append(msha)

          If i.count() = 0 Then I = Enumerable.Range(0, mf.Count()).ToList()

          mv = msh.Vertices().ToPoint3dArray().tolist()

          cf = I.Count()

          'Assign Colors
          If mshe.VertexColors.Count() &lt; 1 Then
            mshe.VertexColors.CreateMonotoneMesh(color.LightGray)
            bmC = biC
          Else
            bmC = True
          End If

          If msha.VertexColors.Count() &gt; 0 Then bmC = True

          mc = mshe.VertexColors().ToArray().ToList()
          If msha.VertexColors.count() &lt; 1 Then mc.addrange(mc) Else mc.addrange(msha.VertexColors().ToArray().ToList())

        Else
          'Start Deconstruct if Curve
          crv = G0

          I.clear()
          I.add(0)
          Dim nbc As nurbscurve
          Dim pc As polyline
          Dim nps As Rhino.Geometry.Collections.NurbsCurvePointList

          nbc = crv.ToNurbsCurve()
          nps = nbc.Points
          pc = nbc.Points.ControlPolygon
          If (Not pc.IsClosed) Then pc.add(pc(0))
          av(0) = pc.CenterPoint

          msh.Vertices.AddVertices(pc.ToArray())
          msh.faces.addfaces(pc.TriangulateClosedPolyline())
          msh.Vertices.Remove(pc.count() - 1, True)

          mv = msh.Vertices.ToPoint3dArray().tolist()
          mte = msh.TopologyEdges()
          mtv = msh.TopologyVertices()

          If (c And r) Then
            ReDim bnk(mv.count() - 1)
            For j = 0 To mv.count() - 1 Step 1
              bnk(j) = True
            Next
          End If

          'Assign Colors
          If bic Then bmC = True

          If G1 IsNot Nothing Then
            crva = G1
            nbc = crva.ToNurbsCurve()
            nps = nbc.Points
            pc = nbc.Points.ControlPolygon
            If (Not pc.IsClosed) Then pc.add(pc(0))
            av(1) = pc.CenterPoint
            pc.RemoveAt(pc.count() - 1)

            If pc.count() &lt;&gt; mv.count() Then Exit Sub

            cf = 1
            mv.addrange(pc)
          Else
            Dim tcpt As point3d
            msh.Normals.ComputeNormals()
            msh.Normals.UnitizeNormals()
            k = mv.count()
            For j = 0 To k - 1 Step 1
              mv.add(mv.item(j) + msh.Normals(j) * d)
              tcpt += mv.item(j) + msh.Normals(j) * d
            Next

            cf = 1
            av(1) = tcpt / k
          End If

        End If
        ce = mte.count()
        cv = mv.count() / 2
        dcv = mv.count()

        x = appendprepend(cv - 1)
        'Match variables and colors to vertex count
        If (T0.count()) &lt; cv Then T0 = dblDList(matchDbl(T0, cv)) Else If (T0.count()) = cv Then T0.addrange(T0) Else If (T0.count()) &lt; dcv Then T0 = matchDbl(T0, dcv)
        If (T1.count()) &lt; cv Then T1 = dblDList(matchDbl(T1, cv)) Else If (T1.count()) = cv Then T1.addrange(T1) Else If (T1.count()) &lt; dcv Then T1 = matchDbl(T1, dcv)
        If (T2.count()) &lt; cv Then T2 = dblDList(matchDbl(T2, cv)) Else If (T2.count()) = cv Then T2.addrange(T2) Else If (T2.count()) &lt; dcv Then T2 = matchDbl(T2, dcv)
        If (T3.count()) &lt; cv Then T3 = dblDList(matchDbl(T3, cv)) Else If (T3.count()) = cv Then T3.addrange(T3) Else If (T3.count()) &lt; dcv Then T3 = matchDbl(T3, dcv)
        If (clr.count()) &lt; cv Then clr = dblCList(matchClr(clr, cv)) Else If (clr.count()) = cv Then clr.addrange(clr)Else If (clr.count()) &lt; dcv Then clr = matchClr(clr, dcv)

        If bp Then
          mc = clr
          ac = colorCap(mc)
        End If

        'Edge based vertices
        k = 0
        Dim cpt As point3d
        Dim ccl As color
        Dim bce As Boolean

        jj = 0
        For j = 0 To ce - 1 Step 1
          If (bm Or (bp And (mte.GetConnectedFaces(j).Count() &lt; 2))) Then
            ua = mtv.MeshVertexIndices(mte.GetTopologyVertices(j).I)(0)
            va = mtv.MeshVertexIndices(mte.GetTopologyVertices(j).J)(0)

            ub = ua + cv
            vb = va + cv

            cpt = (mv(ua) + mv(va) + mv(ub) + mv(vb)) / 4
            ccl = avg4Clr(mc(ua), mc(va), mc(ub), mc(vb))
            bce = mte.GetConnectedFaces(j).count() &lt;&gt; 2

            If c Then
              If r Then
                ecv.add(evalP(mv(ua), mv(va), 0.5))
                ecc.add(evalC(mc(ua), mc(va), 0.5))
                mev.add(ua &amp; "," &amp; va &amp; "," &amp; 3, jj)
                mev.add(va &amp; "," &amp; ua &amp; "," &amp; 3, jj)

                ecv.add(evalP(mv(ub), mv(vb), 0.5))
                ecc.add(evalC(mc(ub), mc(vb), 0.5))
                mev.add(ub &amp; "," &amp; vb &amp; "," &amp; 3, jj + 1)
                mev.add(vb &amp; "," &amp; ub &amp; "," &amp; 3, jj + 1)
                jj += 2
              Else
                If bce Then
                  ecv.add(cpt)
                  ecc.add(ccl)
                  mev.add(ua &amp; "," &amp; va &amp; "," &amp; 3, jj)
                  mev.add(va &amp; "," &amp; ua &amp; "," &amp; 3, jj)
                  jj += 1
                End If
              End If
            End If

            ep.add(evalP(mv(ua), cpt, t0(ua)))
            ec.add(evalC(mc(ua), ccl, t0(ua)))
            en.add(bce)
            mev.add(ua &amp; "," &amp; va &amp; "," &amp; 0, k)

            ep.add(evalP(mv(va), cpt, t0(va)))
            ec.add(evalC(mc(va), ccl, t0(va)))
            en.add(bce)
            mev.add(va &amp; "," &amp; ua &amp; "," &amp; 0, k + 1)

            ep.add(evalP(mv(ub), cpt, t0(ub)))
            ec.add(evalC(mc(ub), ccl, t0(ub)))
            en.add(bce)
            mev.add(ub &amp; "," &amp; vb &amp; "," &amp; 0, k + 2)

            ep.add(evalP(mv(vb), cpt, t0(vb)))
            ec.add(evalC(mc(vb), ccl, t0(vb)))
            en.add(bce)
            mev.add(vb &amp; "," &amp; ub &amp; "," &amp; 0, k + 3)

            ep.add(evalP((mv(ua) + mv(ub)) / 2, cpt, (t1(ua) + t1(ub)) / 2))
            ec.add(evalC(evalC(mc(ua), mc(ub), 0.5), ccl, (t1(ua) + t1(ub)) / 2))
            en.add(bce)
            mev.add(ua &amp; "," &amp; va &amp; "," &amp; 1, k + 4)
            mev.add(ub &amp; "," &amp; vb &amp; "," &amp; 1, k + 4)

            ep.add(evalP((mv(va) + mv(vb)) / 2, cpt, (t1(va) + t1(vb)) / 2))
            ec.add(evalC(evalC(mc(va), mc(vb), 0.5), ccl, (t1(va) + t1(vb)) / 2))
            en.add(bce)
            mev.add(va &amp; "," &amp; ua &amp; "," &amp; 1, k + 5)
            mev.add(vb &amp; "," &amp; ub &amp; "," &amp; 1, k + 5)

            ep.add(evalP((mv(ua) + mv(va)) / 2, cpt, (t1(ua) + t1(va)) / 2))
            ec.add(evalC(evalC(mc(ua), mc(va), 0.5), ccl, (t1(ua) + t1(va)) / 2))
            en.add(bce)
            mev.add(ua &amp; "," &amp; va &amp; "," &amp; 2, k + 6)
            mev.add(va &amp; "," &amp; ua &amp; "," &amp; 2, k + 6)

            ep.add(evalP((mv(ub) + mv(vb)) / 2, cpt, (t1(ub) + t1(vb)) / 2))
            ec.add(evalC(evalC(mc(ub), mc(vb), 0.5), ccl, (t1(ub) + t1(vb)) / 2))
            en.add(bce)
            mev.add(ub &amp; "," &amp; vb &amp; "," &amp; 2, k + 7)
            mev.add(vb &amp; "," &amp; ub &amp; "," &amp; 2, k + 7)

            k += 8
          End If
        Next

        If (c And r) Then
          k = 0
          For j = 0 To ubound(bnk) Step 1
            If bnk(j) Then
              np.add((mv(j) + mv(j + cv)) / 2)
              nc.add(evalC(mc(j), mc(j + cv), 0.5))
              mvv.add(j &amp; "," &amp; j + cv &amp; "," &amp; 0, k)
              k += 1
            End If
          Next
        End If

        'Face based vertices
        Dim xv(),mt(),ei(),xi() As Integer
        Dim xca(),xcb(),xta(),xtb() As color
        Dim xn As Double
        ReDim ei(9)
        ReDim xi(1)
        u = 9
        v = ep.count()
        If c Then
          If r Then
            v += ecv.count() + np.count() + mv.count()
          Else
            v += cf * 2 + ecv.count()
          End If
        End If

        For jj = 0 To I.count() - 1 Step 1
          Dim tcv As New point3d
          j = I(jj)
          w = v + tv.count()
          xn = 0
          If bm Then
            If mf(j).isquad() Then h = 4 Else h = 3
            ReDim xv(h - 1)
            ReDim xca(h - 1)
            ReDim xcb(h - 1)
            ReDim xta(h - 1)
            ReDim xtb(h - 1)
            mt = mf.GetTopologicalVertices(j)
            For k = 0 To h - 1 Step 1
              xv(k) = mtv.MeshVertexIndices(mt(k))(0)
              xca(k) = mc(xv(k))
              xcb(k) = mc(xv(k) + cv)
              xta(k) = clr(xv(k))
              xtb(k) = clr(xv(k) + cv)
            Next
            av(0) = mf.GetFaceCenter(j)
            av(1) = msh.faces.GetFaceCenter(j + cf)
            ac(0) = avgClr(xca)
            ac(1) = avgClr(xcb)
            ax(0) = avgClr(xta)
            ax(1) = avgClr(xtb)
            If biC Then ac(2) = sumC(ax(0), ax(1)) Else ac(2) = sumC(ac(0), ac(1))
          Else
            h = cv
            xv = Enumerable.Range(0, h).ToArray()
          End If
          For k = 0 To h - 1 Step 1
            xn += T1(xv(k))
          Next
          xn /= h
          av(2) = (av(0) + av(1)) / 2
          y = appendprepend(h - 1)

          For k = 1 To h Step 1
            ei(0) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k + 1)) &amp; "," &amp; 0)
            ei(1) = mev.item(xv(y(k)) + cv &amp; "," &amp; xv(y(k + 1)) + cv &amp; "," &amp; 0)
            ei(2) = mev.item(xv(y(k + 1)) &amp; "," &amp; xv(y(k)) &amp; "," &amp; 0)
            ei(3) = mev.item(xv(y(k + 1)) + cv &amp; "," &amp; xv(y(k)) + cv &amp; "," &amp; 0)
            ei(4) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k + 1)) &amp; "," &amp; 1)
            ei(5) = mev.item(xv(y(k + 1)) &amp; "," &amp; xv(y(k)) &amp; "," &amp; 1)
            ei(6) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k + 1)) &amp; "," &amp; 2)
            ei(7) = mev.item(xv(y(k + 1)) + cv &amp; "," &amp; xv(y(k)) + cv &amp; "," &amp; 2)

            'Define new per face vertices
            tv.add(evalP(mv(xv(y(k))), av(0), t0(xv(y(k)))))
            tc.add(evalC(mc(xv(y(k))), ac(0), t0(xv(y(k)))))

            tv.add(evalP(mv(xv(y(k)) + cv), av(1), t0(xv(y(k)) + cv)))
            tc.add(evalC(mc(xv(y(k)) + cv), ac(1), t0(xv(y(k)) + cv)))

            tv.add(evalP(mv(xv(y(k))), av(2), t2(xv(y(k)))))
            tc.add(evalC(mc(xv(y(k))), ac(2), t2(xv(y(k)))))

            tv.add(evalP(mv(xv(y(k)) + cv), av(2), t2(xv(y(k)) + cv)))
            tc.add(evalC(mc(xv(y(k)) + cv), ac(2), t2(xv(y(k)) + cv)))

            tv.add(evalP((mv(xv(y(k))) + mv(xv(y(k + 1)))) / 2, av(0), (t1(xv(y(k))) + t1(xv(y(k + 1)))) / 2))
            tc.add(evalC(evalC(mc(xv(y(k))), mc(xv(y(k + 1))), 0.5), ac(0), (t1(xv(y(k))) + t1(xv(y(k + 1)))) / 2))

            tv.add(evalP((mv(xv(y(k)) + cv) + mv(xv(y(k + 1)) + cv)) / 2, av(1), (t1(xv(y(k)) + cv) + t1(xv(y(k + 1)) + cv)) / 2))
            tc.add(evalC(evalC(mc(xv(y(k)) + cv), mc(xv(y(k + 1)) + cv), 0.5), ac(1), (t1(xv(y(k)) + cv) + t1(xv(y(k + 1)) + cv)) / 2))

            tv.add(evalP((mv(xv(y(k))) + mv(xv(y(k + 1)))) / 2, (av(0) + av(1)) / 2, (t3(xv(y(k))) + t3(xv(y(k + 1)))) / 2))
            tc.add(evalC(evalC(mc(xv(y(k))), mc(xv(y(k + 1))), 0.5), sumC(ac(0), ac(1)), (t3(xv(y(k))) + t3(xv(y(k + 1)))) / 2))

            tv.add(evalP((mv(xv(y(k)) + cv) + mv(xv(y(k + 1)) + cv)) / 2, av(2), (t3(xv(y(k)) + cv) + t3(xv(y(k + 1)) + cv)) / 2))
            tc.add(evalC(evalC(mc(xv(y(k)) + cv), mc(xv(y(k + 1)) + cv), 0.5), ac(2), (t3(xv(y(k)) + cv) + t3(xv(y(k + 1)) + cv)) / 2))

            tv.add(evalP((mv(xv(y(k))) + mv(xv(y(k)) + cv)) / 2, av(2), (t3(xv(y(k))) + t3(xv(y(k)) + cv)) / 2))
            tc.add(evalC(evalC(mc(xv(y(k))), mc(xv(y(k)) + cv), 0.5), ac(2), (t3(xv(y(k))) + t3(xv(y(k)) + cv)) / 2))

            'Define new faces
            xf.add(New meshface(ei(4), ei(1), w + y(k) * u + 3, w + y(k) * u + 8))
            xf.add(New meshface(ei(0), ei(4), w + y(k) * u + 8, w + y(k) * u + 2))

            xf.add(New meshface(ei(3), ei(5), w + y(k + 1) * u + 8, w + y(k + 1) * u + 3))
            xf.add(New meshface(ei(5), ei(2), w + y(k + 1) * u + 2, w + y(k + 1) * u + 8))

            xf.add(New meshface(ei(1), ei(7), w + y(k) * u + 7, w + y(k) * u + 3))
            xf.add(New meshface(ei(7), ei(3), w + y(k + 1) * u + 3, w + y(k) * u + 7))

            xf.add(New meshface(ei(6), ei(0), w + y(k) * u + 2, w + y(k) * u + 6))
            xf.add(New meshface(ei(2), ei(6), w + y(k) * u + 6, w + y(k + 1) * u + 2))

            xf.add(New meshface(w + y(k) * u, w + y(k) * u + 4, w + y(k) * u + 6, w + y(k) * u + 2))
            xf.add(New meshface(w + y(k) * u + 4, w + y(k + 1) * u, w + y(k + 1) * u + 2, w + y(k) * u + 6))

            xf.add(New meshface(w + y(k) * u + 5, w + y(k) * u + 1, w + y(k) * u + 3, w + y(k) * u + 7))
            xf.add(New meshface(w + y(k + 1) * u + 1, w + y(k) * u + 5, w + y(k) * u + 7, w + y(k + 1) * u + 3))

            If c Then
              If r Then
                ei(8) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k + 1)) &amp; "," &amp; 3)
                ei(9) = mev.item(xv(y(k)) + cv &amp; "," &amp; xv(y(k + 1)) + cv &amp; "," &amp; 3)

                xf.add(New meshface(w + y(k) * u + 4, w + y(k) * u + 0, v - mv.count() + xv(y(k)), ep.count() + ei(8)))
                xf.add(New meshface(w + y(k + 1) * u + 0, w + y(k) * u + 4, ep.count() + ei(8), v - mv.count() + xv(y(k + 1))))

                xf.add(New meshface(w + y(k) * u + 1, w + y(k) * u + 5, ep.count() + ei(9), v - mv.count() + xv(y(k)) + cv))
                xf.add(New meshface(w + y(k) * u + 5, w + y(k + 1) * u + 1, v - mv.count() + xv(y(k + 1)) + cv, ep.count() + ei(9)))
                If en.item(ei(0)) Then
                  xi(0) = mvv.item(xv(y(k)) &amp; "," &amp; xv(y(k)) + cv &amp; "," &amp; 0)
                  xi(1) = mvv.item(xv(y(k + 1)) &amp; "," &amp; xv(y(k + 1)) + cv &amp; "," &amp; 0)

                  xf.add(New meshface(ei(0), ei(6), ep.count() + ei(8), v - mv.count() + xv(y(k))))
                  xf.add(New meshface(ei(6), ei(2), v - mv.count() + xv(y(k + 1)), ep.count() + ei(8)))

                  xf.add(New meshface(ep.count() + ecv.count() + xi(1), v - mv.count() + xv(y(k + 1)), ei(2), ei(5)))
                  xf.add(New meshface(v - mv.count() + xv(y(k + 1)) + cv, ep.count() + ecv.count() + xi(1), ei(5), ei(3)))

                  xf.add(New meshface(ei(7), ei(1), v - mv.count() + xv(y(k)) + cv, ep.count() + ei(9)))
                  xf.add(New meshface(ei(3), ei(7), ep.count() + ei(9), v - mv.count() + xv(y(k + 1)) + cv))

                  xf.add(New meshface(ei(1), ei(4), ep.count() + ecv.count() + xi(0), v - mv.count() + xv(y(k)) + cv))
                  xf.add(New meshface(ei(4), ei(0), v - mv.count() + xv(y(k)), ep.count() + ecv.count() + xi(0)))

                End If
              Else
                xf.add(New meshface(w + y(k) * u + 1, w + y(k) * u + 5, v + jj * 2 - cf * 2 + 1, w + y(k - 1) * u + 5))
                xf.add(New meshface(w + y(k) * u + 4, w + y(k) * u, w + y(k - 1) * u + 4, v + jj * 2 - cf * 2))
                If en.item(ei(0)) Then
                  ei(8) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k + 1)) &amp; "," &amp; 3)
                  xf.add(New meshface(ei(4), ei(0), ei(6), ep.count() + ei(8)))
                  xf.add(New meshface(ei(2), ei(5), ep.count() + ei(8), ei(6)))
                  xf.add(New meshface(ei(7), ei(1), ei(4), ep.count() + ei(8)))
                  xf.add(New meshface(ei(3), ei(7), ep.count() + ei(8), ei(5)))
                End If
              End If
            End If
          Next
          If c Then
            If (Not r) Then
              fv.add(av(0))
              cc.add(ac(0))

              fv.add(av(1))
              cc.add(ac(1))
            End If
          End If
        Next

        Dim om As New mesh
        om.Vertices.AddVertices(ep.toarray())
        If bmC Then om.VertexColors.AppendColors(ec.toarray())

        If c Then
          om.Vertices.AddVertices(ecv)
          If bmC Then om.VertexColors.AppendColors(ecc.toarray())
          If r Then
            om.Vertices.AddVertices(np)
            If bmC Then om.VertexColors.AppendColors(nc.toarray())
            om.Vertices.AddVertices(mv)
            If bmC Then om.VertexColors.AppendColors(mc.toarray())
          Else
            om.Vertices.AddVertices(fv)
            If bmC Then om.VertexColors.AppendColors(cc.toarray())
          End If
        End If

        om.Vertices.AddVertices(tv.toarray())
        If bmC Then om.VertexColors.AppendColors(tc.toarray())

        om.Faces.AddFaces(xf.toarray())

        If (c And r) Then om.Flip(True, True, True)

        'If i.count() &gt; 0 Then om.Vertices.CullUnused()

        A = om
      End If
    End If
</item>
