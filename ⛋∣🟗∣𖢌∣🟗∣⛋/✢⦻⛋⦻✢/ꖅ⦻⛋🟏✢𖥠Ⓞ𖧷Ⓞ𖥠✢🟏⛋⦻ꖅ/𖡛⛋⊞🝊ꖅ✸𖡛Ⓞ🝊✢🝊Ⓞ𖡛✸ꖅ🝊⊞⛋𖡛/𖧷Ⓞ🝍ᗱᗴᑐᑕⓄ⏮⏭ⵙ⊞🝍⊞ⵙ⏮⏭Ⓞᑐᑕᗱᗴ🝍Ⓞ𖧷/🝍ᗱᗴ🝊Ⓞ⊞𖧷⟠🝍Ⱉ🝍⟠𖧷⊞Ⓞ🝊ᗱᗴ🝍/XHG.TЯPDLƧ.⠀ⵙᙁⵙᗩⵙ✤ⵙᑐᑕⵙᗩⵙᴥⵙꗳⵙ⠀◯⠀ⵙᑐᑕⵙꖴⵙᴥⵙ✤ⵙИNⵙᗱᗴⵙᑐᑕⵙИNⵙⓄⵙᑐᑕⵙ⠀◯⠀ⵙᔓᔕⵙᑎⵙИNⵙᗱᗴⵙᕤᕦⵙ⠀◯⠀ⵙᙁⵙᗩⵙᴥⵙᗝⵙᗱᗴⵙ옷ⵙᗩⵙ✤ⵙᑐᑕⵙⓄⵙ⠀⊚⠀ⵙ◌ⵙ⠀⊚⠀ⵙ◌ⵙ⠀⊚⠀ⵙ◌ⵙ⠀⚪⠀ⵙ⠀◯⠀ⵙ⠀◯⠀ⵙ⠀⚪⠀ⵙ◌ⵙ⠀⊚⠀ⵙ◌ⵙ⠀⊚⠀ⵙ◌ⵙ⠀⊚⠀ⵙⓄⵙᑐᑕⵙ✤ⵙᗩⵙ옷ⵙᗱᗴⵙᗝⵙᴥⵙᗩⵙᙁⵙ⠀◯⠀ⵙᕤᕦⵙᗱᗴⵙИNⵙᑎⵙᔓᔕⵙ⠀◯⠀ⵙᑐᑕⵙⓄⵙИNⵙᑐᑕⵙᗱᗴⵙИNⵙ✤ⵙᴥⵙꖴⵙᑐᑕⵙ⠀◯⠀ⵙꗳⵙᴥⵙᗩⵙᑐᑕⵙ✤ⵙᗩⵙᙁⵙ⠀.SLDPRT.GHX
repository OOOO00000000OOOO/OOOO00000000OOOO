                    <item name="AdditionalSource" type_name="gh_string" type_code="10">  Private Function appendprepend(ByVal i As Integer)
    Dim srsEnum As IEnumerable(Of Integer) = Enumerable.Range(0, i + 1)
    Dim arrVal As New list(Of Integer)
    arrVal = srsEnum.tolist()
    arrVal.add(0)
    arrVal.insert(0, i)
    Return arrVal.toarray()
  End Function

  Private Function colorCap(ByVal c As list(Of color))
    Dim i,k As Integer
    k = c.count() / 2
    Dim r(2),g(2),b(2) As Integer
    For i = 0 To k - 1 Step 1
      r(0) += c.item(i).R
      r(1) += c.item(i + k).R
      g(0) += c.item(i).g
      g(1) += c.item(i + k).g
      b(0) += c.item(i).b
      b(1) += c.item(i + k).b
    Next

    r(0) = CInt(r(0) / k)
    r(1) = CInt(r(1) / k)
    g(0) = CInt(g(0) / k)
    g(1) = CInt(g(1) / k)
    b(0) = CInt(b(0) / k)
    b(1) = CInt(b(1) / k)

    r(2) = CInt((r(0) + r(1)) / 2)
    g(2) = CInt((g(0) + g(1)) / 2)
    b(2) = CInt((b(0) + b(1)) / 2)

    If r(0) &gt; 255 Then r(0) = 255 Else If r(0) &lt; 0 Then r(0) = 0
    If r(1) &gt; 255 Then r(1) = 255 Else If r(1) &lt; 0 Then r(1) = 0
    If g(0) &gt; 255 Then g(0) = 255 Else If g(0) &lt; 0 Then g(0) = 0
    If g(1) &gt; 255 Then g(1) = 255 Else If g(1) &lt; 0 Then g(1) = 0
    If b(0) &gt; 255 Then b(0) = 255 Else If b(0) &lt; 0 Then b(0) = 0
    If b(1) &gt; 255 Then b(1) = 255 Else If b(1) &lt; 0 Then b(1) = 0

    If r(2) &gt; 255 Then r(2) = 255 Else If r(2) &lt; 0 Then r(2) = 0
    If g(2) &gt; 255 Then g(2) = 255 Else If g(2) &lt; 0 Then g(2) = 0
    If b(2) &gt; 255 Then b(2) = 255 Else If b(2) &lt; 0 Then b(2) = 0

    Return {color.FromArgb(r(0), G(0), b(0)),color.FromArgb(r(1), G(1), b(1)),color.FromArgb(r(2), G(2), b(2))}
  End Function

  Private Function dblCList(ByVal a As list(Of color))
    a.addrange(a)
    Return a
  End Function

  Private Function dblDList(ByVal a As list(Of Double))
    a.addrange(a)
    Return a
  End Function

  Private Function matchDbl(ByVal a As list(Of Double), ByVal t As Integer)
    Dim i,k As Integer
    k = a.count()
    For i = 0 To ((t + 1) - k) - 1 Step 1
      a.add(a.item(k - 1))
    Next
    Return a
  End Function

  Private Function matchClr(ByVal a As list(Of Color), ByVal t As Integer)
    Dim i,k As Integer
    k = a.count()
    For i = 0 To ((t + 1) - k) - 1 Step 1
      a.add(a.item(k - 1))
    Next
    Return a
  End Function

  Private Function sumC(ByVal ca As Color, ByVal cb As Color)
    Dim r,g,b As Integer

    r = CInt((CInt(ca.R) + CInt(cb.R)) / 2)
    g = CInt((CInt(ca.g) + CInt(cb.g)) / 2)
    b = CInt((CInt(ca.b) + CInt(cb.b)) / 2)

    If r &gt; 255 Then r = 255 Else If r &lt; 0 Then r = 0
    If G &gt; 255 Then G = 255 Else If G &lt; 0 Then G = 0
    If b &gt; 255 Then b = 255 Else If b &lt; 0 Then b = 0

    Return color.FromArgb(r, G, b)
  End Function

  Private Function avg4Clr(ByVal ca As Color, ByVal cb As Color, ByVal cc As Color, ByVal cd As Color)
    Dim r,g,b As Integer

    r = CInt((CInt(ca.R) + CInt(cb.R) + CInt(cc.R) + CInt(cd.R)) / 4)
    g = CInt((CInt(ca.g) + CInt(cb.g) + CInt(cc.g) + CInt(cd.g)) / 4)
    b = CInt((CInt(ca.b) + CInt(cb.b) + CInt(cc.b) + CInt(cd.b)) / 4)

    If r &gt; 255 Then r = 255 Else If r &lt; 0 Then r = 0
    If G &gt; 255 Then G = 255 Else If G &lt; 0 Then G = 0
    If b &gt; 255 Then b = 255 Else If b &lt; 0 Then b = 0

    Return color.FromArgb(r, G, b)
  End Function

  Private Function evalP(ByVal op As point3d, ByVal tp As Point3d, ByVal t As Double)
    Return New point3d(op + (tp - op) * t)
  End Function

  Private Function evalV(ByVal ov As vector3d, ByVal tv As vector3d, ByVal t As Double)
    Return New vector3d(ov + (tv - ov) * t)
  End Function

  Private Function evalN(ByVal u As Double, ByVal v As Double, ByVal t As Double)
    Return u + (v - u) * t
  End Function

  Private Function avgVec(ByVal v() As vector3f)
    Dim i As Integer
    Dim tv As Vector3d

    For i = 0 To ubound(v) Step 1
      tv += v(i)
    Next
    tv /= (ubound(v) + 1)
    tv.Unitize()
    Return New vector3f(tv.X, tv.Y, tv.Z)
  End Function

  Private Function roundClr(ByVal r As Integer, ByVal G As Integer, ByVal b As Integer, ByVal i As Integer)
    r = CInt(r / i)
    G = CInt(G / i)
    b = CInt(b / i)

    If r &gt; 255 Then r = 255 Else If r &lt; 0 Then r = 0
    If G &gt; 255 Then G = 255 Else If G &lt; 0 Then G = 0
    If b &gt; 255 Then b = 255 Else If b &lt; 0 Then b = 0

    Return color.FromArgb(r, G, b)
  End Function

  Private Function avgClr(ByVal c() As color)
    Dim r,G,b As Integer
    Dim i,k As Integer

    k = ubound(c) + 1

    For i = 0 To k - 1 Step 1
      r += CInt(c(i).R)
      G += CInt(c(i).G)
      b += CInt(c(i).B)
    Next

    r = CInt(r / k)
    G = CInt(G / k)
    b = CInt(b / k)

    If r &gt; 255 Then r = 255 Else If r &lt; 0 Then r = 0
    If G &gt; 255 Then G = 255 Else If G &lt; 0 Then G = 0
    If b &gt; 255 Then b = 255 Else If b &lt; 0 Then b = 0

    Return color.FromArgb(r, G, b)
  End Function

  Private Function evalC(ByVal oc As color, ByVal tc As color, ByVal t As Double)
    Dim r,G,b As Integer
    r = CInt(CInt(oc.R) + (CInt(tc.R) - CInt(oc.R)) * t)
    G = CInt(CInt(oc.G) + (CInt(tc.G) - CInt(oc.G)) * t)
    b = CInt(CInt(oc.B) + (CInt(tc.B) - CInt(oc.B)) * t)

    If r &gt; 255 Then r = 255 Else If r &lt; 0 Then r = 0
    If G &gt; 255 Then G = 255 Else If G &lt; 0 Then G = 0
    If b &gt; 255 Then b = 255 Else If b &lt; 0 Then b = 0

    Return color.FromArgb(r, G, b)
  End Function

  ''' &lt;summary&gt;
  ''' This method will be called once every solution, before any calls to RunScript.
  ''' &lt;/summary&gt;
  Public Overrides Sub BeforeRunScript()
  End Sub
  ''' &lt;summary&gt;
  ''' This method will be called once every solution, after any calls to RunScript.
  ''' &lt;/summary&gt;
  Public Overrides Sub AfterRunScript()
  End Sub
</item>
                    <item name="Description" type_name="gh_string" type_code="10">Creates a mesh which spans two meshes bridging them from either the vertex or edge center</item>
                    <item name="EditorPosition" type_name="gh_drawing_point" type_code="30">
                      <X>18</X>
                      <Y>222</Y>
                    </item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
                    <item name="IconOverride" type_name="gh_drawing_bitmap" type_code="37">
                      <bitmap length="1163"></bitmap>
                    </item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">2e6b149d-329f-499d-8835-df102c701609</item>
                    <item name="Locked" type_name="gh_bool" type_code="1">true</item>
                    <item name="Name" type_name="gh_string" type_code="10">Box</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Box</item>
                    <item name="OutParameter" type_name="gh_bool" type_code="1">true</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    Component.Params.Input(0).Name = "Mesh or Curve"
    Component.Params.Input(0).Description = "Open or closed mesh or curve"
    Component.Params.Input(1).Name = "Mesh or Curve"
    Component.Params.Input(1).Description = "Optional open or closed mesh or curve whose type should correspond to G0."
    Component.Params.Input(2).Name = "Index [Face]"
    Component.Params.Input(2).Description = "An optional integer or list of integers which specify the faces to be modified if the input is a mesh. If no value is supplied then all faces will be modified"
    Component.Params.Input(3).Name = "From Vert [Vertex]"
    Component.Params.Input(3).Description = "Evaluates a new vertex from the input geometry's vertex"
    Component.Params.Input(4).Name = "Transverse [Vertex]"
    Component.Params.Input(4).Description = "Evaluates a new vertex between G0 and G1"
    Component.Params.Input(5).Name = "Distance"
    Component.Params.Input(5).Description = "An optional number to add depth if no input is provided for G1"
    Component.Params.Input(6).Name = "Close"
    Component.Params.Input(6).Description = "If true then additional faces and if needed vertices will be added to the mesh, closing the solid"
    Component.Params.Input(7).Name = "Flip"
    Component.Params.Input(7).Description = "If true, flips the topology"
    Component.Params.Input(8).Name = "Color [Vertex]"
    Component.Params.Input(8).Description = "(If applied to a mesh a list of colors corresponding to each mesh face, if applied to a curve, a list of colors corresponding to each control point plus an additonal color value for the new averaged center"

    Component.Params.Output(1).Name = "Mesh"
    Component.Params.Output(1).Description = "If successful, a valid mesh"

    If G0 IsNot Nothing Then

      Dim bG,bM, bP,bmC,biC As Boolean

      bM = G0.ObjectType = ObjectType.Mesh
      bP = G0.ObjectType = ObjectType.Curve

      bG = (bM Or bP)
      If G1 IsNot Nothing Then
        If bM And G1.ObjectType &lt;&gt; ObjectType.Mesh Then bG = False
        If bP And G1.ObjectType &lt;&gt; ObjectType.Curve Then bG = False
      End If

      If bG Then
        Dim msh,msha,mshe As New mesh
        Dim crv,crva As curve
        Dim av(2) As point3d
        Dim ac(2),ax(1) As color
        Dim h,j,jj,k,u,v,ua,ub,va,vb,w As Integer
        Dim cv,cf,ce,dcv As Integer
        Dim x(),y() As Integer
        Dim bnk() As Boolean = Nothing

        Dim mv,fv,ep,tv,ecv,np As New list(Of Point3d)
        Dim mev,mvv As New dictionary(Of String, Integer)
        Dim mf As Rhino.Geometry.Collections.MeshFaceList = Nothing
        Dim mtv As Rhino.Geometry.Collections.MeshTopologyVertexList = Nothing
        Dim mte As Rhino.Geometry.Collections.MeshTopologyEdgeList = Nothing
        Dim ev As New list(Of vector3d)
        Dim ed As New list(Of Double)
        Dim en As New list(Of Boolean)
        Dim mc,ec,tc,cc,fc,ecc,nc As New list(Of color)
        Dim xf As New list(Of meshface)

        If clr.count() = 0 Then clr.add(color.LightGray) Else biC = True

        If bm Then
          'Start Deconstruct if Mesh
          msh = G0

          mshe = msh.Duplicate()
          mte = mshe.TopologyEdges()
          mtv = mshe.TopologyVertices()
          mf = mshe.Faces()

          bnk = mshe.GetNakedEdgePointStatus()

          If G1 IsNot Nothing Then
            msha = G1

            If msh.Vertices.Count() &lt;&gt; msha.vertices.count() Then Exit Sub
          Else
            msha = msh.Offset(-d)
          End If

          msh.Append(msha)

          If i.count() = 0 Then I = Enumerable.Range(0, mf.Count()).ToList()

          mv = msh.Vertices().ToPoint3dArray().tolist()

          cf = I.Count()

          'Assign Colors
          If mshe.VertexColors.Count() &lt; 1 Then
            mshe.VertexColors.CreateMonotoneMesh(color.LightGray)
            bmC = biC
          Else
            bmC = True
          End If

          If msha.VertexColors.Count() &gt; 0 Then bmC = True

          mc = mshe.VertexColors().ToArray().ToList()
          If msha.VertexColors.count() &lt; 1 Then mc.addrange(mc) Else mc.addrange(msha.VertexColors().ToArray().ToList())
        Else
          'Start Deconstruct if Curve
          crv = G0

          I.clear()
          I.add(0)
          Dim nbc As nurbscurve
          Dim pc As polyline
          Dim nps As Rhino.Geometry.Collections.NurbsCurvePointList

          nbc = crv.ToNurbsCurve()
          nps = nbc.Points
          pc = nbc.Points.ControlPolygon
          If (Not pc.IsClosed) Then pc.add(pc(0))
          av(0) = pc.CenterPoint

          msh.Vertices.AddVertices(pc.ToArray())
          msh.faces.addfaces(pc.TriangulateClosedPolyline())
          msh.Vertices.Remove(pc.count() - 1, True)

          mv = msh.Vertices.ToPoint3dArray().tolist()
          mte = msh.TopologyEdges()
          mtv = msh.TopologyVertices()

          ReDim bnk(mv.count() - 1)
          For j = 0 To mv.count() - 1 Step 1
            bnk(j) = True
          Next

          'Assign Colors
          If bic Then bmC = True

          If G1 IsNot Nothing Then
            crva = G1
            nbc = crva.ToNurbsCurve()
            nps = nbc.Points
            pc = nbc.Points.ControlPolygon
            If (Not pc.IsClosed) Then pc.add(pc(0))
            av(1) = pc.CenterPoint
            pc.RemoveAt(pc.count() - 1)

            If pc.count() &lt;&gt; mv.count() Then Exit Sub

            cf = 1
            mv.addrange(pc)
          Else
            Dim tcpt As point3d
            msh.Normals.ComputeNormals()
            msh.Normals.UnitizeNormals()
            k = mv.count()
            For j = 0 To k - 1 Step 1
              mv.add(mv.item(j) + msh.Normals(j) * d)
              tcpt += mv.item(j) + msh.Normals(j) * d
            Next

            cf = 1
            av(1) = tcpt / k
          End If

        End If
        ce = mte.count()
        cv = mv.count() / 2
        dcv = mv.count()

        x = appendprepend(cv - 1)
        'Match variables and colors to vertex count
        If (T0.count()) &lt; cv Then T0 = dblDList(matchDbl(T0, cv)) Else If (T0.count()) = cv Then T0.addrange(T0) Else If (T0.count()) &lt; dcv Then T0 = matchDbl(T0, dcv)
        If (T1.count()) &lt; cv Then T1 = dblDList(matchDbl(T1, cv)) Else If (T1.count()) = cv Then T1.addrange(T1) Else If (T1.count()) &lt; dcv Then T1 = matchDbl(T1, dcv)
        If (clr.count()) &lt; cv Then clr = dblCList(matchClr(clr, cv)) Else If (clr.count()) = cv Then clr.addrange(clr)Else If (clr.count()) &lt; dcv Then clr = matchClr(clr, dcv)

        If bp Then
          mc = clr
          ac = colorCap(mc)
        End If

        'Edge based vertices
        k = 0
        Dim cpt As point3d
        Dim ccl As color
        Dim bce As Boolean

        Dim tpt(3) As point3d
        Dim tcl(3) As color
        jj = 0
        For j = 0 To ce - 1 Step 1
          If (bm Or (bp And (mte.GetConnectedFaces(j).Count() &lt; 2))) Then
            ua = mtv.MeshVertexIndices(mte.GetTopologyVertices(j).I)(0)
            va = mtv.MeshVertexIndices(mte.GetTopologyVertices(j).J)(0)

            ub = ua + cv
            vb = va + cv

            cpt = (mv(ua) + mv(va) + mv(ub) + mv(vb)) / 4
            ccl = avg4Clr(mc(ua), mc(va), mc(ub), mc(vb))
            bce = mte.GetConnectedFaces(j).count() &lt;&gt; 2

            tpt(0) = evalP(mv(ua), mv(va), t0(ua) / 2)
            tcl(0) = evalC(mc(ua), mc(va), t0(ua) / 2)
            tpt(1) = evalP(mv(va), mv(ua), t0(va) / 2)
            tcl(1) = evalC(mc(va), mc(ua), t0(va) / 2)
            tpt(2) = evalP(mv(ub), mv(vb), t0(ub) / 2)
            tcl(2) = evalC(mc(ub), mc(vb), t0(ub) / 2)
            tpt(3) = evalP(mv(vb), mv(ub), t0(vb) / 2)
            tcl(3) = evalC(mc(vb), mc(ub), t0(vb) / 2)

            'To the Face Center
            ep.add(evalP(tpt(0), tpt(2), t1(ua) / 2))
            ec.add(evalC(tcl(0), tcl(2), t1(ua) / 2))
            en.add(bce)
            mev.add(ua &amp; "," &amp; va &amp; "," &amp; 0, k)

            ep.add(evalP(tpt(2), tpt(0), t1(ub) / 2))
            ec.add(evalC(tcl(2), tcl(0), t1(ub) / 2))
            en.add(bce)
            mev.add(ub &amp; "," &amp; vb &amp; "," &amp; 0, k + 1)

            ep.add(evalP(tpt(1), tpt(3), t1(va) / 2))
            ec.add(evalC(tcl(1), tcl(3), t1(va) / 2))
            en.add(bce)
            mev.add(va &amp; "," &amp; ua &amp; "," &amp; 0, k + 2)

            ep.add(evalP(tpt(3), tpt(1), t1(vb) / 2))
            ec.add(evalC(tcl(3), tcl(1), t1(vb) / 2))
            en.add(bce)
            mev.add(vb &amp; "," &amp; ub &amp; "," &amp; 0, k + 3)

            If (c And f) Then
              ecv.add(evalP((mv(ua) + mv(va)) / 2, (mv(ub) + mv(vb)) / 2, (t1(ua) + t1(va)) / 4))
              ecc.add(evalC(evalC(mc(ua), mc(va), 0.5), evalC(mc(ub), mc(vb), 0.5), (t1(ua) + t1(va)) / 4))
              mev.add(ua &amp; "," &amp; va &amp; "," &amp; 3, jj)
              mev.add(va &amp; "," &amp; ua &amp; "," &amp; 3, jj)

              ecv.add(evalP((mv(ub) + mv(vb)) / 2, (mv(ua) + mv(va)) / 2, (t1(ub) + t1(vb)) / 4))
              ecc.add(evalC(evalC(mc(ub), mc(vb), 0.5), evalC(mc(ua), mc(va), 0.5), (t1(ub) + t1(vb)) / 4))
              mev.add(ub &amp; "," &amp; vb &amp; "," &amp; 3, jj + 1)
              mev.add(vb &amp; "," &amp; ub &amp; "," &amp; 3, jj + 1)

              jj += 2
            End If

            If f Then
              ep.add(tpt(0))
              ec.add(tcl(0))
              en.add(bce)
              mev.add(ua &amp; "," &amp; va &amp; "," &amp; 1, k + 4)

              ep.add(tpt(1))
              ec.add(tcl(1))
              en.add(bce)
              mev.add(va &amp; "," &amp; ua &amp; "," &amp; 1, k + 5)

              ep.add(tpt(2))
              ec.add(tcl(2))
              en.add(bce)
              mev.add(ub &amp; "," &amp; vb &amp; "," &amp; 1, k + 6)

              ep.add(tpt(3))
              ec.add(tcl(3))
              en.add(bce)
              mev.add(vb &amp; "," &amp; ub &amp; "," &amp; 1, k + 7)

              ep.add((mv(ua) + mv(va)) / 2)
              ec.add(evalC(mc(ua), mc(va), 0.5))
              en.add(bce)
              mev.add(ua &amp; "," &amp; va &amp; "," &amp; 2, k + 8)
              mev.add(va &amp; "," &amp; ua &amp; "," &amp; 2, k + 8)

              ep.add((mv(ub) + mv(vb)) / 2)
              ec.add(evalC(mc(ub), mc(vb), 0.5))
              en.add(bce)
              mev.add(ub &amp; "," &amp; vb &amp; "," &amp; 2, k + 9)
              mev.add(vb &amp; "," &amp; ub &amp; "," &amp; 2, k + 9)

              k += 10
            Else
              k += 4
            End If
          End If
        Next

        k = 0
        For j = 0 To ubound(bnk) Step 1
          np.add(mv(j))
          nc.add(mc(j))
          mvv.add(j &amp; "," &amp; j + cv &amp; "," &amp; 0, k)

          np.add(mv(j + cv))
          nc.add(mc(j + cv))
          mvv.add(j + cv &amp; "," &amp; j &amp; "," &amp; 0, k + 1)

          k += 2
        Next

        'Face based vertices
        Dim xv(),mt(),ei(),xi() As Integer
        Dim xca(),xcb(),xta(),xtb() As color
        Dim xn(1) As Double
        ReDim ei(17)
        ReDim xi(1)
        u = 4
        If f Then u += 4
        v += ep.count()
        If (Not f) Then v += np.count()
        If (c And f) Then v += ecv.count()

        For jj = 0 To I.count() - 1 Step 1
          Dim tcv As New point3d
          j = I(jj)
          w = v + tv.count()
          xn(0) = 0
          xn(1) = 0
          If bm Then
            If mf(j).isquad() Then h = 4 Else h = 3
            ReDim xv(h - 1)
            ReDim xca(h - 1)
            ReDim xcb(h - 1)
            ReDim xta(h - 1)
            ReDim xtb(h - 1)
            mt = mf.GetTopologicalVertices(j)
            For k = 0 To h - 1 Step 1
              xv(k) = mtv.MeshVertexIndices(mt(k))(0)
              xca(k) = mc(xv(k))
              xcb(k) = mc(xv(k) + cv)
              xta(k) = clr(xv(k))
              xtb(k) = clr(xv(k) + cv)
            Next
            av(0) = mf.GetFaceCenter(j)
            av(1) = msh.faces.GetFaceCenter(j + cf)
            ac(0) = avgClr(xca)
            ac(1) = avgClr(xcb)
            ax(0) = avgClr(xta)
            ax(1) = avgClr(xtb)
            If biC Then ac(2) = sumC(ax(0), ax(1)) Else ac(2) = sumC(ac(0), ac(1))
          Else
            h = cv
            xv = Enumerable.Range(0, h).ToArray()
          End If
          For k = 0 To h - 1 Step 1
            xn(0) += T0(xv(k))
            xn(1) += T0(xv(k) + cv)
          Next
          xn(0) /= h
          xn(1) /= h
          av(2) = (av(0) + av(1)) / 2
          y = appendprepend(h - 1)

          For k = 1 To h Step 1
            ei(0) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k + 1)) &amp; "," &amp; 0)
            ei(1) = mev.item(xv(y(k + 1)) &amp; "," &amp; xv(y(k)) &amp; "," &amp; 0)
            ei(2) = mev.item(xv(y(k)) + cv &amp; "," &amp; xv(y(k + 1)) + cv &amp; "," &amp; 0)
            ei(3) = mev.item(xv(y(k + 1)) + cv &amp; "," &amp; xv(y(k)) + cv &amp; "," &amp; 0)

            If f Then
              ei(4) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k - 1)) &amp; "," &amp; 0)
              ei(5) = mev.item(xv(y(k)) + cv &amp; "," &amp; xv(y(k - 1)) + cv &amp; "," &amp; 0)

              ei(6) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k + 1)) &amp; "," &amp; 1)
              ei(7) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k - 1)) &amp; "," &amp; 1)

              ei(8) = mev.item(xv(y(k)) + cv &amp; "," &amp; xv(y(k + 1)) + cv &amp; "," &amp; 1)
              ei(9) = mev.item(xv(y(k)) + cv &amp; "," &amp; xv(y(k - 1)) + cv &amp; "," &amp; 1)

              ei(10) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k + 1)) &amp; "," &amp; 2)
              ei(11) = mev.item(xv(y(k)) &amp; "," &amp; xv(y(k - 1)) &amp; "," &amp; 2)

              ei(12) = mev.item(xv(y(k)) + cv &amp; "," &amp; xv(y(k + 1)) + cv &amp; "," &amp; 2)
              ei(13) = mev.item(xv(y(k)) + cv &amp; "," &amp; xv(y(k - 1)) + cv &amp; "," &amp; 2)

              tpt(0) = evalP((mv(xv(y(k))) + mv(xv(y(k + 1)))) / 2, av(0), (t0(xv(y(k))) + t0(xv(y(k + 1)))) / 2)
              tcl(0) = evalC(evalC(mc(xv(y(k))), mc(xv(y(k + 1))), 0.5), ac(0), (t0(xv(y(k))) + t0(xv(y(k + 1)))) / 2)
              tpt(1) = evalP((mv(xv(y(k)) + cv) + mv(xv(y(k + 1)) + cv)) / 2, av(1), (t0(xv(y(k)) + cv) + t0(xv(y(k + 1)) + cv)) / 2)
              tcl(1) = evalC(evalC(mc(xv(y(k)) + cv), mc(xv(y(k + 1)) + cv), 0.5), ac(1), (t0(xv(y(k)) + cv) + t0(xv(y(k + 1)) + cv)) / 2)
            Else
              tpt(0) = evalP(mv(xv(y(k))), av(0), t0(xv(y(k))))
              tcl(0) = evalC(mc(xv(y(k))), ac(0), t0(xv(y(k))))
              tpt(1) = evalP(mv(xv(y(k)) + cv), av(1), t0(xv(y(k)) + cv))
              tcl(1) = evalC(mc(xv(y(k)) + cv), ac(1), t0(xv(y(k)) + cv))
            End If
            tpt(2) = evalP(tpt(0), tpt(1), t1(xv(y(k))) / 2)
            tcl(2) = evalC(tcl(0), ac(2), t1(xv(y(k))))
            tpt(3) = evalP(tpt(1), tpt(0), t1(xv(y(k)) + cv) / 2)
            tcl(3) = evalC(tcl(1), ac(2), t1(xv(y(k)) + cv))

            'Define new per face vertices
            tv.add(tpt(0))
            tc.add(tcl(0))

            tv.add(tpt(1))
            tc.add(tcl(1))

            tv.add(tpt(2))
            tc.add(tcl(2))

            tv.add(tpt(3))
            tc.add(tcl(3))

            'Define new faces
            If f Then
              tv.add((tpt(2) + ep(ei(0))) / 2)
              tc.add(evalC(tcl(2), ec(ei(0)), 0.5))

              tv.add((tpt(2) + ep(ei(1))) / 2)
              tc.add(evalC(tcl(2), ec(ei(1)), 0.5))

              tv.add((tpt(3) + ep(ei(2))) / 2)
              tc.add(evalC(tcl(3), ec(ei(2)), 0.5))

              tv.add((tpt(3) + ep(ei(3))) / 2)
              tc.add(evalC(tcl(3), ec(ei(3)), 0.5))

              xf.add(New meshface(ei(0), ei(4), ei(7), ei(6)))
              xf.add(New meshface(ei(11), ei(10), ei(6), ei(7)))
              xf.add(New meshface(ei(11), w + y(k - 1) * u + 0, w + y(k) * u + 0, ei(10)))
              xf.add(New meshface(w + y(k) * u + 4, w + y(k) * u + 2, w + y(k - 1) * u + 2, w + y(k - 1) * u + 5))
              xf.add(New meshface(ei(0), w + y(k) * u + 4, w + y(k - 1) * u + 5, ei(4)))
              xf.add(New meshface(w + y(k) * u + 4, ei(0), ei(2), w + y(k) * u + 6))
              xf.add(New meshface(w + y(k) * u + 2, w + y(k) * u + 4, w + y(k) * u + 6, w + y(k) * u + 3))
              xf.add(New meshface(w + y(k) * u + 0, w + y(k) * u + 2, w + y(k + 1) * u + 2, w + y(k + 1) * u + 0))
              xf.add(New meshface(ei(4), w + y(k - 1) * u + 5, w + y(k - 1) * u + 7, ei(5)))
              xf.add(New meshface(w + y(k - 1) * u + 2, w + y(k - 1) * u + 3, w + y(k - 1) * u + 7, w + y(k - 1) * u + 5))
              xf.add(New meshface(w + y(k) * u + 6, ei(2), ei(5), w + y(k - 1) * u + 7))
              xf.add(New meshface(w + y(k) * u + 3, w + y(k) * u + 6, w + y(k - 1) * u + 7, w + y(k - 1) * u + 3))
              xf.add(New meshface(ei(2), ei(8), ei(9), ei(5)))
              xf.add(New meshface(ei(8), ei(12), ei(13), ei(9)))
              xf.add(New meshface(ei(12), w + y(k) * u + 1, w + y(k - 1) * u + 1, ei(13)))
              xf.add(New meshface(w + y(k) * u + 1, w + y(k) * u + 3, w + y(k - 1) * u + 3, w + y(k - 1) * u + 1))

            Else
              xf.add(New meshface(ep.count() + xv(y(k + 1)) * 2, ep.count() + xv(y(k)) * 2, w + y(k) * u + 0, w + y(k + 1) * u + 0))
              xf.add(New meshface(w + y(k) * u + 0, w + y(k) * u + 2, w + y(k + 1) * u + 2, w + y(k + 1) * u + 0))
              xf.add(New meshface(w + y(k) * u + 2, ei(0), ei(1), w + y(k + 1) * u + 2))
              xf.add(New meshface(ei(0), w + y(k) * u + 2, w + y(k) * u + 3, ei(2)))
              xf.add(New meshface(w + y(k + 1) * u + 2, ei(1), ei(3), w + y(k + 1) * u + 3))
              xf.add(New meshface(ei(2), w + y(k) * u + 3, w + y(k + 1) * u + 3, ei(3)))
              xf.add(New meshface(w + y(k) * u + 3, w + y(k) * u + 1, w + y(k + 1) * u + 1, w + y(k + 1) * u + 3))
              xf.add(New meshface(ep.count() + xv(y(k)) * 2 + 1, ep.count() + xv(y(k + 1)) * 2 + 1, w + y(k + 1) * u + 1, w + y(k) * u + 1))
            End If

            If c Then
              If en.item(ei(0)) Then
                If f Then
                  ei(14) = v - ecv.count() + mev.item(xv(y(k)) &amp; "," &amp; xv(y(k + 1)) &amp; "," &amp; 3)
                  ei(15) = v - ecv.count() + mev.item(xv(y(k)) + cv &amp; "," &amp; xv(y(k + 1)) + cv &amp; "," &amp; 3)
                  ei(16) = mev.item(xv(y(k + 1)) &amp; "," &amp; xv(y(k)) &amp; "," &amp; 1)
                  ei(17) = mev.item(xv(y(k + 1)) + cv &amp; "," &amp; xv(y(k)) + cv &amp; "," &amp; 1)

                  xf.add(New meshface(ei(14), ei(0), ei(6), ei(10)))
                  xf.add(New meshface(ei(1), ei(14), ei(10), ei(16)))
                  xf.add(New meshface(ei(14), ei(1), ei(3), ei(15)))
                  xf.add(New meshface(ei(2), ei(0), ei(14), ei(15)))
                  xf.add(New meshface(ei(2), ei(15), ei(12), ei(8)))
                  xf.add(New meshface(ei(17), ei(12), ei(15), ei(3)))

                Else
                  xf.add(New meshface(ei(1), ei(0), ep.count() + xv(y(k)) * 2, ep.count() + xv(y(k + 1)) * 2))
                  xf.add(New meshface(ei(0), ei(2), ep.count() + xv(y(k)) * 2 + 1, ep.count() + xv(y(k)) * 2))
                  xf.add(New meshface(ei(2), ei(3), ep.count() + xv(y(k + 1)) * 2 + 1, ep.count() + xv(y(k)) * 2 + 1))
                  xf.add(New meshface(ei(3), ei(1), ep.count() + xv(y(k + 1)) * 2, ep.count() + xv(y(k + 1)) * 2 + 1))
                End If
              End If
            End If
          Next
          fv.add(evalP(av(2), av(0), xn(0)))
          cc.add(evalC(ac(2), ac(0), xn(0)))

          fv.add(evalP(av(2), av(1), xn(1)))
          cc.add(evalC(ac(2), ac(1), xn(1)))
        Next

        Dim om As New mesh
        om.Vertices.AddVertices(ep.toarray())
        If bmC Then om.VertexColors.AppendColors(ec.toarray())
        If (Not f) Then
          om.Vertices.AddVertices(np.toarray())
          If bmC Then om.VertexColors.AppendColors(nc.toarray())
        End If

        If (c And f) Then
          om.Vertices.AddVertices(ecv.toarray())
          If bmC Then om.VertexColors.AppendColors(ecc.toarray())
        End If

        om.Vertices.AddVertices(tv.toarray())
        If bmC Then om.VertexColors.AppendColors(tc.toarray())

        om.Faces.AddFaces(xf.toarray())


        'If i.count() &gt; 0 Then om.Vertices.CullUnused()

        A = om
      End If
    End If
</item>
                  </items>
