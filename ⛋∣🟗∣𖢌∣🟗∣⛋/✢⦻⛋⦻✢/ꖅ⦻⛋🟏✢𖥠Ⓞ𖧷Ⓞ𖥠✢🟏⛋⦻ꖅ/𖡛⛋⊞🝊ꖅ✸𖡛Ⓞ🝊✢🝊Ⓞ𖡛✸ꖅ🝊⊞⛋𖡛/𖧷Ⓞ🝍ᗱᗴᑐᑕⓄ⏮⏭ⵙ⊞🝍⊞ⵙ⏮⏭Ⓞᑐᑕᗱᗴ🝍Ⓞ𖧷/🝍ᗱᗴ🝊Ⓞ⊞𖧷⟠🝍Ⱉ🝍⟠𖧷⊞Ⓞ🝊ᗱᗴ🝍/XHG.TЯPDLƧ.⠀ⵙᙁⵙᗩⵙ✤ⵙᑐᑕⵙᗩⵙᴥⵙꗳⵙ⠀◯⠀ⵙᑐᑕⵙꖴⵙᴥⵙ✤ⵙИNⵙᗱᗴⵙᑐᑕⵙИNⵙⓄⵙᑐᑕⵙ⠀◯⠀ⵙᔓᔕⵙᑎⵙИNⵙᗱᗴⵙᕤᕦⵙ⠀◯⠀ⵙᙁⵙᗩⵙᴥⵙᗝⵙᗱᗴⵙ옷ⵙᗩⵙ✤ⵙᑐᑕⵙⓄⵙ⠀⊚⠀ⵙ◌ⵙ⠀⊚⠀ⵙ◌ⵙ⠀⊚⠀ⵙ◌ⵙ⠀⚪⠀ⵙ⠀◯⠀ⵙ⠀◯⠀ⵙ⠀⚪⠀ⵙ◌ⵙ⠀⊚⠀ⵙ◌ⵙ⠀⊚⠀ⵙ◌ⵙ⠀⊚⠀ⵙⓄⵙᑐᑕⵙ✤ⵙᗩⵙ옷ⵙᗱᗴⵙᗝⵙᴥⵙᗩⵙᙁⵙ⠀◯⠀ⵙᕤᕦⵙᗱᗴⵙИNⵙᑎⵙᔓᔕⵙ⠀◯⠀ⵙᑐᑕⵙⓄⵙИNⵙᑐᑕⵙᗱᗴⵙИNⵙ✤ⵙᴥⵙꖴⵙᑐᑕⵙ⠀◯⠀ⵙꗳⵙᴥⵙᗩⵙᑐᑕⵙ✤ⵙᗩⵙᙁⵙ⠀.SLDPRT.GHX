                                </item>
                                <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                                  <X>480.5</X>
                                  <Y>887</Y>
                                </item>
                              </items>
                            </chunk>
                          </chunks>
                        </chunk>
                        <chunk name="InputParam" index="1">
                          <items count="12">
                            <item name="AllowTreeAccess" type_name="gh_bool" type_code="1">true</item>
                            <item name="Description" type_name="gh_string" type_code="10">Script Variable G1</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">dd4f60a5-424d-470e-b974-c56b502a6656</item>
                            <item name="Locked" type_name="gh_bool" type_code="1">true</item>
                            <item name="Name" type_name="gh_string" type_code="10">G1</item>
                            <item name="NickName" type_name="gh_string" type_code="10">G1</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">true</item>
